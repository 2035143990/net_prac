# 统一换行符，避免 shell 脚本在 Windows 检出后变成 CRLF 而无法执行。
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.nft text eol=lf
*.cfg text eol=lf
*.txt text eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.svg text eol=lf
*.drawio text eol=lf
