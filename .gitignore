# ============================================================
# 通用生成文件 / 系统文件
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.Spotlight-V100/
.fseventsd/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# 编辑器 / IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*.bak
*.orig
*.rej
.history/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# 环境变量
.env
.env.*
!.env.example

# 日志与临时文件
*.log
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
*.stackdump

# 压缩包 / 缓存
*.tar
*.tar.gz
*.tgz
*.zip
.cache/

# ============================================================
# Containerlab / 本项目生成文件
# ============================================================

# Containerlab 运行时状态目录（clab-<labname>/）
# /clab-*/
# **/clab-*/

# 由 gen.py 生成的拓扑与节点配置
# campus-lab/campus-lab.clab.yml
# campus-lab/configs/

# 由 gen-drawio.sh 生成的拓扑图
# campus-lab/campus-lab.clab.drawio

# 自动化测试结果
campus-lab/tests/results/

# 部署时记录的 dockerd MainPID（供 preflight 判断环境是否被重启）
campus-lab/.deploy-dockerd-pid

# 临时验证脚本与输出（.wsl- 前缀）
campus-lab/.wsl-*

# Containerlab 可能产生的日志
*.clab.log
